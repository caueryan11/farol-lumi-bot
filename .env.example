# Copie para .env e preencha. O .env nunca vai para o git.

# --- IA (console.anthropic.com -> Settings -> API Keys) ---
ANTHROPIC_API_KEY=
# opcional; padrão claude-haiku-4-5 (bot/assistente.py)
MODELO_BOT=claude-haiku-4-5

# --- Banco: projeto Supabase das POUSADAS (Connect -> Connection string, pooler) ---
DATABASE_URL=

# --- WhatsApp via uazapi ---
# Instância "do ambiente": usada pelas pousadas sem uazapi_token próprio no banco (pousadas.uazapi_token).
UAZAPI_URL=https://SEU-SUBDOMINIO.uazapi.com
UAZAPI_TOKEN=
# segredo que vai no caminho da URL do webhook, 16+ caracteres
# (gere com: python -c "import secrets; print(secrets.token_urlsafe(24))")
WEBHOOK_SEGREDO=

# Só existe o modo pousada neste repositório (qualquer outro valor impede o app de subir).
NEGOCIO=pousada

# Rotinas: relatório mensal (dia 1º, 9h), prazo de guarda (3h) e monitor do WhatsApp (10 min). off desliga.
ROTINAS=on
# Endereço público do app (link do mapa). No Railway fica vazio: usa RAILWAY_PUBLIC_DOMAIN.
URL_PUBLICA=
# Alerta quando o WhatsApp cai (ntfy: https://ntfy.sh/<tópico-difícil>; ou webhook do Discord/Slack)
ALERTA_URL=

# Transcrição de áudio do hóspede (a uazapi chama o Whisper da OpenAI). Vazio = o bot pede texto.
OPENAI_API_KEY=
# Places API (New): lugares perto da pousada na hora. Vazio = só o guia do FAQ.
GOOGLE_PLACES_KEY=
# Mapa do Google na página /mapa/<slug> (chave de NAVEGADOR restrita ao domínio). Vazio = mapa estático.
GOOGLE_MAPS_BROWSER_KEY=

# Só para testes locais de banco (Postgres descartável; nunca o de produção)
# POUSADAS_TESTE_DSN=postgresql://postgres@localhost:54330/postgres
